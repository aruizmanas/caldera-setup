Vagrant.configure("2") do |config|
  # Using a relatively 'light' generic Windows 10 box
  config.vm.box = "generic/windows10"

  # Setting communicator to ssh as requested
  config.vm.communicator = "ssh"

  config.vm.provider "virtualbox" do |vb|
    vb.memory = "2048"
    vb.cpus = 2
    # Ensure GUI is disabled for 'lightweight' feel
    vb.gui = false
  end

  # Generic boxes usually have OpenSSH installed and enabled
  config.vm.network "forwarded_port", guest: 22, host: 2200, id: "ssh"
end
